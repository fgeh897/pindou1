page {
  background: #f7f4ef;
  color: #302116;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: #fffdf8;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(48, 33, 22, 0.06);
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #7b6a5b;
  line-height: 1.6;
}

.primary-btn {
  background: #9d5333;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.ghost-btn {
  background: #fffdf8;
  color: #9d5333;
  border: 1px solid rgba(157, 83, 51, 0.24);
  border-radius: 999rpx;
  font-size: 28rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #745f4b;
}

.field-input,
.field-textarea,
.field-picker {
  width: 100%;
  background: #fff;
  border: 1px solid rgba(48, 33, 22, 0.12);
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
}

.field-textarea {
  min-height: 180rpx;
}

.row {
  display: flex;
  gap: 16rpx;
}

.row > view,
.row > button {
  flex: 1;
}

.muted {
  color: #8a7a6d;
  font-size: 24rpx;
}

.project-item {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1px solid rgba(48, 33, 22, 0.08);
  margin-bottom: 18rpx;
}

.project-name {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.project-meta {
  font-size: 24rpx;
  color: #7b6a5b;
  margin-bottom: 12rpx;
}

.empty {
  text-align: center;
  color: #8a7a6d;
  padding: 80rpx 20rpx;
}
