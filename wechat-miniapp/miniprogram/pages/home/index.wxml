<view class="page">
  <view class="card">
    <view class="title">我的图纸</view>
    <view class="subtitle">
      当前登录用户：{{user.nickName || "未命名用户"}}
    </view>
  </view>

  <view class="card">
    <button class="primary-btn" bindtap="handleCreateProject">新建图纸</button>
  </view>

  <view class="card">
    <view wx:if="{{projects.length === 0}}" class="empty">
      还没有图纸，先新建一个。
    </view>

    <block wx:for="{{projects}}" wx:key="_id">
      <view class="project-item">
        <view class="project-name">{{item.name}}</view>
        <view class="project-meta">
          {{item.gridWidth}} x {{item.gridHeight}} · {{item.status}} · {{item.updatedAtText}}
        </view>
        <view class="row">
          <button class="primary-btn" data-id="{{item._id}}" bindtap="handleOpenProject">打开</button>
          <button class="ghost-btn" data-id="{{item._id}}" bindtap="handleDeleteProject">删除</button>
        </view>
      </view>
    </block>
  </view>
</view>
